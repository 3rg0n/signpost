# Binaries
# Anchored to the root: an unanchored `signpost` matches at any depth and so
# ignores the cmd/signpost/ source directory as well as the built binary.
/signpost
/signpost.exe
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.txt
coverage.html

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
credentials.json
*_rsa
*_ed25519

# signpost's own semantic cache (bundle markdown IS committed; cache is not)
.signpost/cache/

# The graph viewer's data, generated by the Pages deploy and by anyone previewing
# the site locally. Deliberately not committed (ADR 0008): the bundle is committed
# because it survives without the tool installed, but graph.json has no value
# without the page that reads it, and a committed copy is a second artifact that
# can be stale.
/site/graph.json

# Scratch output from the dogfood CI job, which is worth running locally before
# pushing a change to it. Anchored to the root, where the job writes them.
/build1.txt
/build3.txt
/graph.json
/nohist.json

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Scratch
/tmp/
/.tmp/
